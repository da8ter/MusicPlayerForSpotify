{
    "elements": [
        {
            "type": "Label",
            "caption": "Create an app at developer.spotify.com (Dashboard), enter the redirect URI shown below in the app settings and paste the Client ID here. Playback needs Spotify Premium."
        },
        {
            "type": "ValidationTextBox",
            "name": "ClientID",
            "caption": "Client ID",
            "width": "600px"
        },
        {
            "type": "ValidationTextBox",
            "name": "RedirectBase",
            "caption": "Public base address (https), empty = Connect address",
            "width": "600px"
        },
        {
            "type": "ValidationTextBox",
            "name": "PlayerName",
            "caption": "Device name of the tile in Spotify Connect"
        },
        {
            "type": "NumberSpinner",
            "name": "PollInterval",
            "caption": "Update variables every",
            "suffix": " s",
            "minimum": 0
        },
        {
            "type": "List",
            "name": "Favorites",
            "caption": "Favorites (open.spotify.com links to playlists, albums, songs or artists)",
            "rowCount": 6,
            "add": true,
            "delete": true,
            "columns": [
                {
                    "caption": "Name",
                    "name": "Name",
                    "width": "220px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Link",
                    "name": "URL",
                    "width": "auto",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Label",
            "name": "RedirectInfo",
            "caption": ""
        },
        {
            "type": "Label",
            "name": "LoginInfo",
            "caption": ""
        },
        {
            "type": "Button",
            "caption": "Show sign-in link",
            "onClick": "echo SPM_GetAuthURL($id) ?: 'Client ID or redirect URI missing';"
        },
        {
            "type": "Button",
            "caption": "Renew access token",
            "onClick": "echo SPM_RefreshAccessToken($id) ? 'OK' : 'Error, see log';"
        },
        {
            "type": "Button",
            "caption": "Sign out of Spotify",
            "onClick": "SPM_Logout($id); echo 'OK';"
        }
    ],
    "status": [
        {
            "code": 201,
            "icon": "error",
            "caption": "No Client ID"
        },
        {
            "code": 202,
            "icon": "inactive",
            "caption": "Not signed in to Spotify (open the tile and sign in)"
        }
    ]
}
