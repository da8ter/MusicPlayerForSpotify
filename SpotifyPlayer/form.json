{
    "elements": [
        {
            "type": "Label",
            "caption": "Sign in from the tile or with the link below; the sign-in runs through Symcon's OAuth service and needs an active Symcon Connect. Playback needs Spotify Premium."
        },
        {
            "type": "ValidationTextBox",
            "name": "PlayerName",
            "caption": "Device name of the tile in Spotify Connect"
        },
        {
            "type": "NumberSpinner",
            "name": "PollInterval",
            "caption": "Update variables during playback every",
            "suffix": " s",
            "minimum": 0
        },
        {
            "type": "Label",
            "caption": "Without playback at most every 60 s. While a tile is open, it reports the state itself and the instance does not query."
        },
        {
            "type": "List",
            "name": "Favorites",
            "caption": "Favorites (open.spotify.com links to playlists, albums, songs or artists)",
            "rowCount": 6,
            "add": true,
            "delete": true,
            "columns": [
                {
                    "caption": "Name",
                    "name": "Name",
                    "width": "220px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Link",
                    "name": "URL",
                    "width": "auto",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Label",
            "name": "ConnectInfo",
            "caption": ""
        },
        {
            "type": "Label",
            "name": "LoginInfo",
            "caption": ""
        },
        {
            "type": "Button",
            "caption": "Show sign-in link",
            "onClick": "echo SPM_GetAuthURL($id) ?: 'Symcon Connect is not active';"
        },
        {
            "type": "Button",
            "caption": "Test connection",
            "onClick": "echo SPM_TestConnection($id);"
        },
        {
            "type": "Button",
            "caption": "Renew access token",
            "onClick": "echo SPM_RefreshAccessToken($id) ? 'OK' : 'Error, see log';"
        },
        {
            "type": "Button",
            "caption": "Sign out of Spotify",
            "onClick": "SPM_Logout($id); echo 'OK';"
        }
    ],
    "status": [
        {
            "code": 201,
            "icon": "error",
            "caption": "Symcon Connect is not active (needed to sign in)"
        },
        {
            "code": 202,
            "icon": "inactive",
            "caption": "Not signed in to Spotify (open the tile and sign in)"
        }
    ]
}
